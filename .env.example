# Copy to your hosting provider's environment settings (never commit real values).

# Required online
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:5432/kalimenu
APP_URL=https://kalimenu.gr
# Other domains that redirect to APP_URL
REDIRECT_HOSTS=kalimenu.com,www.kalimenu.com,www.kalimenu.gr

# Your own super admin login for /super (password at least 10 characters)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Subscriptions with Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=1        # only after setting up Stripe Tax

# E-mails (password reset, welcome) through Resend – without it e-mails are only printed in the log
RESEND_API_KEY=
MAIL_FROM=Kalimenu <hello@kalimenu.gr>
NOTIFY_EMAIL=

# Optional
# PORT=3000
# DEMO_VENUE=off                 # no public demo venue
