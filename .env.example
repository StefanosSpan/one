# Copy to your hosting provider's environment settings (never commit real values).

# Required online
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:5432/kalimenu
APP_URL=https://kalimenu.gr
# Other domains that redirect to APP_URL
REDIRECT_HOSTS=kalimenu.com,www.kalimenu.com,www.kalimenu.gr
# Every venue on its own address: <code>.kalimenu.gr. Set it only after *.kalimenu.gr works on the hosting (DNS + certificate).
BASE_DOMAIN=

# Your own super admin login for /super (password at least 12 characters; the value here is always the valid one)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Subscriptions with Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=1        # only after setting up Stripe Tax

# Guest payments, "Connect with Viva" (Viva ISV partner program). Without these, venues enter their own Viva keys.
# VIVA_ISV_CLIENT_ID=
# VIVA_ISV_CLIENT_SECRET=
# VIVA_ISV_SOURCE_CODE=         # payment source for ISV, with Success/Failure URL https://kalimenu.gr/pay/viva/return
# VIVA_ISV_ENV=demo             # demo | live
# VIVA_ISV_FEE_PERCENT=0        # Kalimenu fee per payment, e.g. 0.5 (never on the tip)
# VIVA_ISV_FEE_CENTS=0          # fixed fee per payment in cents

# E-mails (password reset, welcome) through Resend – without it e-mails are only printed in the log
RESEND_API_KEY=
MAIL_FROM=Kalimenu <hello@kalimenu.gr>
NOTIFY_EMAIL=

# Optional
# PORT=3000
# DEMO_VENUE=off                 # no public demo venue

# Your business details (footer, terms, privacy policy, data processing agreement)
COMPANY_NAME=
COMPANY_VAT=
COMPANY_TAX_OFFICE=
COMPANY_GEMI=
COMPANY_ADDRESS=
CONTACT_EMAIL=hello@kalimenu.gr
CONTACT_PHONE=
